<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="LittleLinguist.Pages.SettingsPage"

    Header="Settings"
    Background="#FFF7FC"
    NavigationPage.HasNavigationBar="False">

    <Grid Margin="25">

        <!-- Botón para volver -->
        <Button
            Content="← Back"
            Click="BackButton_Click"

            HorizontalAlignment="Left"
            VerticalAlignment="Top"

            FontSize="16"
            Padding="18,10"/>

        <!-- Opciones -->
        <StackPanel
            Width="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <TextBlock
                Text="Settings"
                FontSize="34"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,15"/>

            <CheckBox
                Content="Enable sound"
                IsChecked="True"
                FontSize="17"/>

            <CheckBox
                Content="Enable music"
                IsChecked="True"
                FontSize="17"/>

            <TextBlock
                Text="Difficulty"
                FontSize="17"
                FontWeight="SemiBold"
                Margin="0,10,0,0"/>

            <ComboBox SelectedIndex="0">
                <ComboBoxItem Content="Easy"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Hard"/>
            </ComboBox>

            <TextBlock
                Text="Language"
                FontSize="17"
                FontWeight="SemiBold"
                Margin="0,10,0,0"/>

            <ComboBox SelectedIndex="0">
                <ComboBoxItem Content="English"/>
                <ComboBoxItem Content="Spanish"/>
                <ComboBoxItem Content="Catalan"/>
            </ComboBox>

        </StackPanel>

    </Grid>

</ContentPage>